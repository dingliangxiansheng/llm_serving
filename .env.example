# =============================================================================
# 复制为 .env 后按需修改；docker compose 与宿主机脚本都会读取
# ./scripts/docker_up.sh 会自动生成随机密钥，无需手工填
#
# 注意：下方 TENSOR_PARALLEL_SIZE / GPU_MEMORY_UTILIZATION / MAX_MODEL_LEN 的默认值来自
# 「4×4090、且每卡被宿主机其它容器占掉 15GB」那台机器。换机器时不要照抄——
# scripts/install.sh 末尾会调用 scripts/tune_env.sh，按本机 GPU 实测值重算这四项并写回 .env；
# 想手工控制就 SKIP_TUNE=1 bash scripts/bootstrap.sh。
#
# 内网 / 容器环境（uv 不读 pip.conf，必须显式给这些变量；bootstrap 会自动探测并注入）：
#   UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple        uv 装包索引
#   UV_PYTHON_INSTALL_MIRROR=https://gh-proxy.com/https://github.com/astral-sh/python-build-standalone/releases/download
#   UV_HTTP_TIMEOUT=60                                             防长时间无响应
#   UV_BIN=/path/to/uv                                             指定现成的 uv
# 容器内的权重下载请用 bash scripts/fetch_weight.sh --local（没有 docker 守护进程）
# =============================================================================

# ---------- 模型权重（下载配置） ----------
# 构建/部署时会在「当前仓库的 weight/ 目录」自动下载权重，不需要手工准备。
# 下载逻辑：scripts/fetch_weight.sh -> 下载器容器（docker/Dockerfile.weights）-> modelscope
# 目标目录 = MODEL_PATH（相对路径按仓库根解析），默认 ./weight/Qwen3.8-27B-AWQ-INT4
# 也可手工放权重到任意位置，只要 MODEL_PATH 指过去。
MODEL_ID=cyankiwi/Qwen3.8-27B-AWQ-INT4
MODEL_REVISION=master
# 目录名（MODEL_PATH 未设置时用 ./weight/${WEIGHT_NAME}）
WEIGHT_NAME=Qwen3.8-27B-AWQ-INT4
# modelscope 下载器镜像里的版本（重建/换源时可覆盖）
MODELSCOPE_VERSION=1.40.2
# 并发下载连接数
DOWNLOAD_WORKERS=8
# 完整性判定下限（字节）：INT4 权重约 20GB，低于此值视为没下完
WEIGHT_MIN_BYTES=19000000000

# ---------- 模型 / vLLM ----------
# 权重目录（相对路径相对仓库根；compose 会只读挂载到容器 /models）
MODEL_PATH=./weight/Qwen3.8-27B-AWQ-INT4
SERVED_MODEL_NAME=qwen3.8-27b
VLLM_VERSION=0.31.0
# 张量并行度：把每层权重切几份放几张卡。必须 ≤ GPU 数，且整除 num_kv_heads
#（本模型 num_kv_heads=4 ⇒ 只能 1/2/4）。单卡装得下就用 1（无 all-reduce 开销）。
TENSOR_PARALLEL_SIZE=4
# 单卡允许 vLLM 用掉的比例：必须满足 util×总显存 > 权重/TP + 激活，否则启动即报
# Not enough memory。被其它进程占用时先算：空闲显存/总显存 - 0.02
GPU_MEMORY_UTILIZATION=0.33
# 上下文长度：按 KV 预算推。本模型混合注意力 64KB/token，单卡 32GB 可到 32768
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=2
# 额外 vLLM 参数（值里有空格或 JSON 时必须用单引号包起来，否则 source .env 会报 command not found）
# --reasoning-parser qwen3      把思考过程拆到 reasoning 字段，正文不再混入 </think>
# --enable-auto-tool-choice     允许请求里带 tools + tool_choice=auto（Open WebUI 的工具/联网搜索要用）
# --tool-call-parser qwen3_coder 本模型 chat_template 用的是 <tool_call><function=...> 这套 Qwen3 格式
# --default-chat-template-kwargs  reasoning_effort=low：模板默认 xhigh 会思考很久
# 显存紧张时可加 --enforce-eager（省显存、慢一些）
VLLM_EXTRA_ARGS='--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --default-chat-template-kwargs {"reasoning_effort":"low"}'
HF_HUB_OFFLINE=1
VLLM_LOGGING_LEVEL=INFO
VLLM_PORT=8000
IMAGE_TAG=1.0.0

# ---------- 网关 ----------
GATEWAY_PORT=9000
UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
# header=按 Open WebUI 转发头区分用户（多人必选）；shared=所有人共用一个账号；off=匿名
AUTH_MODE=header
# 管理接口口令：curl -H "X-Admin-Token: $ADMIN_TOKEN" http://127.0.0.1:9000/admin/overview
ADMIN_TOKEN=change-me-please
# Open WebUI 连网关时使用的 key（auth.mode=header 下仅作形式校验）
GATEWAY_API_KEY=sk-llm-serving-internal
GATEWAY_MAX_CONCURRENT=2
GATEWAY_QUEUE_TIMEOUT_S=60
GATEWAY_RPM_PER_USER=60
# 每人每日 token 上限，0 = 不限制
GATEWAY_DAILY_TOKEN_QUOTA=0
GATEWAY_HISTORY_MAX_TURNS=20
# 必须小于 MAX_MODEL_LEN（留出回答空间），否则上游会 400
GATEWAY_MAX_PROMPT_TOKENS=6144
GATEWAY_MEMORY_TOP_K=5
# llm=用模型抽取记忆（多一次调用）；heuristic=正则兜底（省算力）；off=关闭记忆
GATEWAY_MEMORY_EXTRACT_MODE=llm
UPSTREAM_TIMEOUT_S=600
GATEWAY_DB_PATH=data/gateway.db

# ---------- Open WebUI ----------
WEBUI_VERSION=v0.12.3
WEBUI_PORT=8080
# 对外监听地址：0.0.0.0=办公网可访问；改 127.0.0.1 则只能走 SSH 隧道
WEBUI_BIND=0.0.0.0
WEBUI_SECRET_KEY=change-me-too
WEBUI_AUTH=true
# 关闭自助注册，账号由管理员创建（内网开放注册容易失控）
WEBUI_ENABLE_SIGNUP=false
# 首次启动自动创建管理员（后续请在界面改密码）
WEBUI_ADMIN_EMAIL=admin@example.com
# 管理员初始密码（仅首次启动创建账号时生效；之后改这里不会改已有密码，
# 已有账号要用 /api/v1/auths/update/password 或重建 webui.db）
WEBUI_ADMIN_PASSWORD=123456
WEBUI_ADMIN_NAME=管理员

# ---------- 路径（docker compose 挂载用） ----------
DATA_DIR=./data
HF_CACHE_DIR=./data/hf
